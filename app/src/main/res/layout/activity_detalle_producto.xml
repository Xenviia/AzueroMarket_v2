<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_cream">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_green"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="@android:color/white"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Imagen/Emoji del producto -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/accent_light">
                <TextView
                    android:id="@+id/tvImagenProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🌾"
                    android:textSize="72sp"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Chip categoría -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/tvCategoriaChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categoría"
                    app:chipBackgroundColor="@color/chip_green_bg"
                    android:textColor="@color/primary_green"
                    android:layout_marginBottom="8dp"/>

                <!-- Nombre -->
                <TextView
                    android:id="@+id/tvNombreProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre del producto"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp"/>

                <!-- Emprendedor -->
                <TextView
                    android:id="@+id/tvEmprendedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vendido por Emprendedor"
                    android:textSize="13sp"
                    android:textColor="@color/primary_green"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/tvUbicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 Ubicación"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="12dp"/>

                <!-- Stock -->
                <TextView
                    android:id="@+id/tvStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✅ En stock"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Descripción -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descripción"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descripción del producto"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="16dp"/>

                <!-- Card de precios y cargos -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/accent_light"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💰 Precio y cargos"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvPrecioProducto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$ 0.00"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_orange"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tvCargoServicio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ $ 0.00 cargo de servicio (5%)"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>

                        <TextView
                            android:id="@+id/tvItbms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ $ 0.00 ITBMS (7%)"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="8dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/text_secondary"
                            android:alpha="0.2"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvTotalConCargos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total: $ 0.00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Productos relacionados -->
                <TextView
                    android:id="@+id/tvRelacionadosTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Más productos"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProductosRelacionados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="8dp"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Botones fijos abajo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:padding="12dp"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContactarProductor"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="💬 Chatear"
            app:strokeColor="@color/primary_green"
            android:textColor="@color/primary_green"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSolicitarProducto"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1.5"
            android:text="🛒 Agregar al Carrito"
            app:backgroundTint="@color/primary_green"
            android:textColor="@android:color/white"
            app:cornerRadius="10dp"/>

    </LinearLayout>

</LinearLayout>
